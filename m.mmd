flowchart TB
    U["利用者<br/>(PC/スマホ)"] --> CDN["CDN / WAF"]
    CDN --> LB["ロードバランサ"]
    LB --> WEB["Web/App（BFF兼務）<br/>認証・認可・集約・レート制限"]

    subgraph Services["アプリケーションサービス"]
        Catalog["商品/カタログ"]
        Order["注文/決済"]
        Member["会員/マイページ"]
        Stock["在庫同期"]
        Admin["管理/運用"]
        AI["AI分析<br/>(オンライン/バッチ)"]
    end

    WEB --> Catalog
    WEB --> Order
    WEB --> Member
    WEB --> Stock
    WEB --> Admin
    WEB --> AI

    subgraph Data["データストア"]
        RDB[(RDBクラスタ<br/>スキーマ分離)]
        OrderDB[(Order DB（分離）)]
        CatalogReplica[(Catalog Read Replica)]
        Cache[(Redisキャッシュ<br/>Catalog中心)]
        Obj[(オブジェクトストレージ)]
        EventLog[(イベントログ)]
    end

    Catalog --> RDB
    Member --> RDB
    Stock --> RDB
    Admin --> RDB
    Order --> OrderDB
    Catalog --> CatalogReplica
    RDB -.-> CatalogReplica

    Catalog --> Cache
    Order -.-> Cache
    Catalog --> Obj
    Catalog --> EventLog
    Order --> EventLog
    Member --> EventLog
    EventLog --> AI
    AI -.-> RDB
    AI -.-> Cache

    subgraph External["外部連携"]
        Pay["決済ゲートウェイ"]
        Inv["在庫管理システム"]
        Mail["メール/SMS"]
        MQ["メッセージキュー"]
        Auth["Auth / IdP<br/>Admin分離"]
    end

    Order --> Pay
    Member --> Mail
    Inv --> MQ
    MQ --> Stock
    WEB --> Auth

    subgraph Ops["運用・監視"]
        Obs["Logging / Monitoring / Tracing"]
        Alert["Alerting"]
        CICD["CI/CD"]
    end

    WEB --> Obs
    Catalog --> Obs
    Order --> Obs
    Obs --> Alert
    CICD --> WEB
